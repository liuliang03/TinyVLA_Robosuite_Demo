# TinyVLA 环境变量配置

# 模型路径
export TINYVLA_MODELS_DIR="models"
export TINYVLA_CACHE_DIR="models/llava_pythia"
export TINYVLA_DEFAULT_MODEL="lesjie/Llava-Pythia-400M"

# 设备配置
export TINYVLA_DEVICE="cpu"
export TINYVLA_DTYPE="float32"

# IK 配置
export TINYVLA_IK_METHOD="optimization"
export TINYVLA_USE_IK="true"

# 日志配置
export TINYVLA_LOG_LEVEL="INFO"

# HuggingFace 配置
export HF_HOME="models/.cache"
export HF_HUB_CACHE="models/.cache/hub"
export HF_HUB_OFFLINE="1"  # 离线模式

# 镜像配置（如需使用镜像）
# export HF_ENDPOINT=https://hf-mirror.com
